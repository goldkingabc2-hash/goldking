name: Auto Update JioTVPlus3

on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download Jojo M3U
        run: |
          curl -L "https://raw.githubusercontent.com/maybetv/jojo/refs/heads/main/Jojo.m3u" -o JioTVPlus3.m3u

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add JioTVPlus3.m3u

          if git diff --cached --quiet; then
            echo "No changes"
          else
            git commit -m "Auto update JioTVPlus3.m3u"
            git push
          fi
